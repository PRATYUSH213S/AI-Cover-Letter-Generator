# Server port
PORT=5000

# Only needed in production when the frontend is served from a different origin.
# In development the Vite dev server origin (http://localhost:5173) is allowed by default.
# CORS_ORIGIN=https://your-frontend.example.com

# Google Gemini (Sprint 04 provider). Get a free key at aistudio.google.com. Never commit it.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash   # default; free-tier supported
# GEMINI_BASE_URL=   # leave unset in production; only for pointing at a local test endpoint
