# Server port
PORT=5000

# Only needed in production when the frontend is served from a different origin.
# In development the Vite dev server origin (http://localhost:5173) is allowed by default.
# CORS_ORIGIN=https://your-frontend.example.com

# OpenAI (Sprint 04 Phase 1). Get a key at platform.openai.com. Never commit it.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # leave unset in production; only for pointing at a local test endpoint
